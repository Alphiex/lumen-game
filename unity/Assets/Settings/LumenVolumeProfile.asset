%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 92b72aa7e888042a09dcf6174a7a5339, type: 3}
  m_Name: LumenVolumeProfile
  m_EditorClassIdentifier: 
  components:
  # Tonemapping — ACES cinematic
  - &1 !u!114
    MonoBehaviour:
      m_Script: {fileID: 11500000, guid: 8c9d44a7e5f6483cb7e2d45f3a6c1234, type: 3}
      active: 1
      parameters:
      - overrideState: 1
        value: 1   # ACES
  # Bloom — motes and wisp glow
  - &2 !u!114
    MonoBehaviour:
      m_Script: {fileID: 11500000, guid: d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5, type: 3}
      active: 1
      parameters:
      - overrideState: 1
        value: 0.8    # threshold
      - overrideState: 1
        value: 0.9    # intensity
      - overrideState: 1
        value: 0.7    # scatter
      - overrideState: 1
        value: 1      # tint (white)
  # Vignette — frame the action
  - &3 !u!114
    MonoBehaviour:
      m_Script: {fileID: 11500000, guid: e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6, type: 3}
      active: 1
      parameters:
      - overrideState: 1
        value: {r: 0, g: 0, b: 0, a: 1}  # color black
      - overrideState: 1
        value: 0.35   # intensity
      - overrideState: 1
        value: 0.5    # smoothness
  # Color Adjustments — warm amber tint
  - &4 !u!114
    MonoBehaviour:
      m_Script: {fileID: 11500000, guid: f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7, type: 3}
      active: 1
      parameters:
      - overrideState: 1
        value: 0      # post-exposure
      - overrideState: 1
        value: -5     # contrast
      - overrideState: 1
        value: {r: 1.05, g: 0.98, b: 0.92, a: 1}  # color filter (warm)
      - overrideState: 1
        value: 0      # hue shift
      - overrideState: 1
        value: -5     # saturation
  # Depth of Field — atmospheric haze
  - &5 !u!114
    MonoBehaviour:
      m_Script: {fileID: 11500000, guid: a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8, type: 3}
      active: 1
      parameters:
      - overrideState: 1
        value: 0      # mode: Bokeh
      - overrideState: 1
        value: 8      # focal length
      - overrideState: 1
        value: 0.1    # aperture
      - overrideState: 1
        value: 18     # focus distance
  # Film Grain
  - &6 !u!114
    MonoBehaviour:
      m_Script: {fileID: 11500000, guid: b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9, type: 3}
      active: 1
      parameters:
      - overrideState: 1
        value: 0      # type: Thin
      - overrideState: 1
        value: 0.15   # intensity
      - overrideState: 1
        value: 0.5    # response
  # Fog — exponential, late-afternoon haze (#8B9BAF)
  - &7 !u!114
    MonoBehaviour:
      m_Script: {fileID: 11500000, guid: c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0, type: 3}
      active: 1
      parameters:
      - overrideState: 1
        value: 1      # mode: Exponential
      - overrideState: 1
        value: 0.06   # density
      - overrideState: 1
        value: 2      # start distance (m)
      - overrideState: 1
        value: {r: 0.545, g: 0.608, b: 0.686, a: 1}  # fogColor #8B9BAF
